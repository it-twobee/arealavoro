{
  "name": "twobee-os",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema interno TwoBee: clienti, tracking, reporting, flussi email",
  "type": "module",
  "engines": {
    "node": ">=23.4.0"
  },
  "scripts": {
    "start": "tsx app/server.js",
    "dev": "tsx watch --clear-screen=false --exclude 'twobee.db*' --exclude 'backup/**' app/server.js",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "db:reset": "tsx app/db.js --reset",
    "backup:decrypt": "tsx backup/decrypt.js",
    "doctor": "tsx app/doctor.js",
    "user:list": "tsx app/user-cli.js list",
    "user:add": "tsx app/user-cli.js add",
    "user:password": "tsx app/user-cli.js password",
    "user:remove": "tsx app/user-cli.js remove",
    "qa": "tsx qa/daily-check.js",
    "extract:klaviyo": "tsx reporting/extract/klaviyo.js",
    "extract:meta": "tsx reporting/extract/meta.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  }
}
